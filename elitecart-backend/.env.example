# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mysql://localhost:3306/elitecart_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root
DDL_AUTO=update
SHOW_SQL=true

# JWT (generate a real 256-bit base64 secret for production!)
JWT_SECRET=c2VjdXJlLWVsaXRlY2FydC1qd3Qtc2VjcmV0LWtleS1jaGFuZ2UtaW4tcHJvZHVjdGlvbi1taW4tMjU2LWJpdHM=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
